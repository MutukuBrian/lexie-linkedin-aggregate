    {
      "parameters": {
        "jsCode": "const config = $('Get configs').first().json;\nconst keyword = $('Loop Over Items').first().json.keyword;\n\nconst scrapeComments  = Boolean(config.scrape_comments);\nconst scrapeReactions = Boolean(config.scrape_reactions);\n\nconst body = {\n  searchQueries:        [keyword],\n  maxPosts:             config.max_posts    || 20,\n  postedLimit:          config.posted_limit || 'any',\n  sortBy:               config.sort_by      || 'date',\n  contentType:          config.content_type || 'all',\n  scrapeReactions,\n  postNestedReactions:  false,\n  scrapeComments,\n  postNestedComments:   false,\n};\n\nif (scrapeReactions) body.maxReactions = config.max_reactions || 5;\nif (scrapeComments)  body.maxComments  = config.max_comments  || 10;\n\nif (config.posted_limit_date)   body.postedLimitDate   = config.posted_limit_date;\nif (config.author_urls)         body.authorUrls        = config.author_urls.split(',').filter(Boolean);\nif (config.authors_companies)   body.authorCompanies   = config.authors_companies.split(',').filter(Boolean);\nif (config.mentioning_member)   body.mentioningMember  = config.mentioning_member.split(',').filter(Boolean);\nif (config.mentioning_company)  body.mentioningCompany = config.mentioning_company.split(',').filter(Boolean);\nif (config.authors_industry_id) body.authorsIndustryId = config.authors_industry_id.split(',').filter(Boolean);\nif (config.author_keywords)     body.authorKeywords    = config.author_keywords.split(',').map(k => k.trim()).filter(Boolean);\n\nreturn [{ json: { body, apifyToken: config.apify_token, searchQuery: keyword } }];"
      },
